{
  "name": "dataforge-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DataForge — a neo-brutalist PostgreSQL IDE for VS Code",
  "workspaces": [
    "extension",
    "webview"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w webview",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "npm run build -w extension",
    "build:webview": "npm run build -w webview",
    "watch": "npm run watch -w extension",
    "type-check": "npm run type-check -w extension && npm run type-check -w webview",
    "test:unit": "npm run test:unit -w extension && npm run test:unit -w webview",
    "test:e2e": "npm run test:e2e -w webview",
    "package": "npm run package -w extension",
    "lint": "oxlint . --fix && eslint . --fix --cache"
  },
  "devDependencies": {
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "oxlint": "~1.82.0",
    "typescript": "~6.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
